<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MiuShop | میو شاپ</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap');

:root{
    --pink:#efb2c5;
    --pink2:#f8d9e2;
    --cream:#fff7ed;
    --brown:#6b4d55;
    --dark:#352b30;
    --white:#fff;
    --muted:#8c7880;
    --line:#f0dfe4;
    --danger:#c65b71;
    --shadow:0 14px 40px rgba(117,72,88,.12);
    --radius:24px;
}

*{
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    margin:0;
    font-family:Vazirmatn,system-ui,sans-serif;
    background:#fffafb;
    color:var(--dark);
}

button,
input,
select{
    font:inherit;
}

button{
    cursor:pointer;
}

.container{
    width:min(1160px,92%);
    margin:auto;
}

/* ================= HEADER ================= */

header{
    position:sticky;
    top:0;
    z-index:30;
    background:rgba(255,250,251,.92);
    backdrop-filter:blur(16px);
    border-bottom:1px solid var(--line);
}

.nav{
    height:78px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.brand{
    display:flex;
    align-items:center;
    gap:12px;
    font-weight:800;
    font-size:20px;
}

.brand img{
    width:54px;
    height:54px;
    object-fit:contain;
    border-radius:16px;
}

.navlinks{
    display:flex;
    gap:8px;
}

.navlinks a,
.admin-btn{
    padding:10px 15px;
    border-radius:14px;
    color:var(--brown);
    font-weight:600;
}

.navlinks a:hover,
.admin-btn:hover{
    background:var(--pink2);
}

.admin-btn{
    border:1px solid var(--line);
    background:white;
}

/* ================= HERO ================= */

.hero{
    padding:54px 0 32px;
}

.hero-card{
    background:linear-gradient(
        135deg,
        #fff0f4,
        #fff9ee
    );

    border:1px solid var(--line);
    border-radius:34px;
    min-height:330px;

    display:grid;
    grid-template-columns:1.2fr .8fr;
    align-items:center;

    overflow:hidden;
    box-shadow:var(--shadow);
}

.hero-copy{
    padding:48px;
}

.badge{
    display:inline-flex;
    background:white;
    border:1px solid var(--line);
    color:#b06b82;
    padding:8px 14px;
    border-radius:99px;
    font-size:13px;
    font-weight:700;
}

.hero h1{
    font-size:clamp(34px,5vw,58px);
    line-height:1.15;
    margin:18px 0 10px;
}

.hero h1 span{
    color:#d78ba2;
}

.hero p{
    color:var(--muted);
    line-height:2;
    margin:0;
    max-width:560px;
}

.hero-logo{
    display:flex;
    justify-content:center;
    align-items:center;
    padding:30px;
}

.hero-logo img{
    width:min(310px,75%);
    aspect-ratio:1;
    object-fit:contain;
    filter:drop-shadow(
        0 18px 25px rgba(164,92,116,.14)
    );
}

/* ================= PRODUCTS ================= */

.section-title{
    display:flex;
    align-items:end;
    justify-content:space-between;
    gap:20px;
    margin:30px 0 18px;
}

.section-title h2{
    margin:0;
    font-size:27px;
}

.section-title p{
    margin:0;
    color:var(--muted);
    font-size:14px;
}

.tools{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    margin-bottom:18px;
}

.search{
    flex:1;
    min-width:220px;

    border:1px solid var(--line);
    background:#fff;
    border-radius:16px;

    padding:13px 16px;
    outline:none;
}

.search:focus{
    border-color:var(--pink);
}

.filters{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
}

.filter{
    border:1px solid var(--line);
    background:#fff;
    padding:11px 14px;
    border-radius:14px;
    color:var(--brown);
}

.filter.active{
    background:var(--pink);
    border-color:var(--pink);
    color:white;
}

.grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
    padding-bottom:65px;
}

/* ================= PRODUCT CARD ================= */

.card{
    background:white;
    border:1px solid var(--line);
    border-radius:22px;
    overflow:hidden;
    box-shadow:0 8px 25px rgba(117,72,88,.06);
    transition:.25s;
}

.card:hover{
    transform:translateY(-4px);
    box-shadow:var(--shadow);
}

.product-img{
    height:240px;
    background:linear-gradient(
        145deg,
        #fff3f6,
        #fffaf1
    );

    display:flex;
    align-items:center;
    justify-content:center;

    position:relative;
}

.product-img img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.placeholder{
    font-size:52px;
    opacity:.6;
}

.discount{
    position:absolute;
    top:12px;
    right:12px;

    background:#e58ca5;
    color:white;

    padding:6px 10px;
    border-radius:12px;

    font-size:12px;
    font-weight:800;

    z-index:2;
}

.info{
    padding:16px;
}

.category{
    font-size:12px;
    color:#c18396;
}

.info h3{
    margin:5px 0 9px;
    font-size:17px;
}

.price{
    display:flex;
    align-items:center;
    gap:9px;
    flex-wrap:wrap;
}

.final{
    font-weight:800;
    color:#9b5d72;
}

.old{
    text-decoration:line-through;
    color:#b8a9ae;
    font-size:12px;
}

.stock{
    margin-top:9px;
    font-size:12px;
    color:#7f7378;
}

.out{
    color:#c65b71;
    font-weight:700;
}

/* ================= FOOTER ================= */

footer{
    border-top:1px solid var(--line);
    padding:28px 0;
    color:var(--muted);
    text-align:center;
    background:#fff;
}

/* ================= MODAL ================= */

.modal{
    position:fixed;
    inset:0;

    background:rgba(47,32,39,.48);

    display:none;
    align-items:center;
    justify-content:center;

    z-index:100;
    padding:16px;
}

.modal.show{
    display:flex;
}

.panel{
    width:min(1000px,100%);
    max-height:92vh;
    overflow:auto;

    background:#fffafb;

    border-radius:28px;

    box-shadow:
        0 30px 80px rgba(0,0,0,.22);
}

.panel-head{
    padding:20px 24px;

    border-bottom:1px solid var(--line);

    display:flex;
    justify-content:space-between;
    align-items:center;

    position:sticky;
    top:0;

    background:#fffafb;

    z-index:2;
}

.close{
    border:0;
    background:#f8e6eb;

    width:40px;
    height:40px;

    border-radius:13px;

    font-size:20px;
}

.login{
    width:min(430px,100%);
    padding:28px;
}

.login h2{
    margin-top:0;
}

/* ================= ADMIN ================= */

.admin-body{
    padding:22px;
}

.admin-grid{
    display:grid;
    grid-template-columns:1fr 1.5fr;
    gap:22px;
}

.box{
    background:white;
    border:1px solid var(--line);
    border-radius:20px;
    padding:18px;
}

.box h3{
    margin-top:0;
}

.field{
    margin:12px 0;
}

.field label{
    display:block;
    font-size:13px;
    font-weight:700;
    margin-bottom:7px;
    color:var(--brown);
}

.field input,
.field select{
    width:100%;

    padding:12px 13px;

    border:1px solid var(--line);
    border-radius:14px;

    outline:none;
    background:#fff;
}

.field input:focus{
    border-color:var(--pink);
}

.row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}

.products-admin{
    display:grid;
    gap:10px;
}

.admin-item{
    display:flex;
    align-items:center;
    gap:12px;

    border:1px solid var(--line);
    border-radius:16px;

    padding:10px;
}

.admin-thumb{
    width:58px;
    height:58px;

    border-radius:13px;

    object-fit:cover;

    background:#fff2f5;
}

.grow{
    flex:1;
}

.small{
    font-size:12px;
    color:var(--muted);
}

.btn{
    border:0;
    border-radius:14px;
    padding:12px 16px;
    font-weight:700;
}

.primary{
    background:var(--pink);
    color:white;
}

.secondary{
    background:#f7e7ec;
    color:#744e5a;
}

.danger{
    background:#ffe3e8;
    color:#b23d57;
}

.notice{
    background:#fff5d8;
    border:1px solid #f2dfaa;
    color:#765f27;

    padding:12px 14px;

    border-radius:15px;

    font-size:12px;
    line-height:1.8;

    margin-bottom:14px;
}

.empty{
    text-align:center;
    padding:50px;
    color:var(--muted);

    grid-column:1/-1;
}

/* ================= MOBILE ================= */

@media(max-width:850px){

    .grid{
        grid-template-columns:repeat(2,1fr);
    }

    .hero-card{
        grid-template-columns:1fr;
    }

    .hero-logo{
        display:none;
    }

    .hero-copy{
        padding:32px;
    }

    .admin-grid{
        grid-template-columns:1fr;
    }
}

@media(max-width:520px){

    .nav{
        height:68px;
    }

    .navlinks a{
        display:none;
    }

    .brand img{
        width:46px;
        height:46px;
    }

    .brand{
        font-size:16px;
    }

    .grid{
        grid-template-columns:1fr 1fr;
        gap:10px;
    }

    .product-img{
        height:180px;
    }

    .info{
        padding:12px;
    }

    .info h3{
        font-size:14px;
    }

    .hero{
        padding-top:25px;
    }

    .hero h1{
        font-size:34px;
    }

    .row{
        grid-template-columns:1fr;
    }

    .admin-item{
        flex-wrap:wrap;
    }
}
</style>
</head>

<body>

<!-- ================= HEADER ================= -->

<header>

<div class="container nav">

<a class="brand" href="#">
    <img src="miushop-logo.jpg" alt="MiuShop">
    <span>MiuShop | میو شاپ</span>
</a>

<nav class="navlinks">
    <a href="#products">محصولات</a>
    <a href="#about">درباره میو شاپ</a>
</nav>

<button class="admin-btn" onclick="openAdmin()">
    ⚙️ مدیریت
</button>

</div>

</header>


<!-- ================= MAIN ================= -->

<main>

<section class="hero">

<div class="container">

<div class="hero-card">

<div class="hero-copy">

<span class="badge">
    🎀 MiuShop Collection
</span>

<h1>
    اکسسوری‌های خاص
    <br>
    <span>برای سلیقه‌های خاص</span>
</h1>

<p>
    مجموعه‌ای از اکسسوری‌های فانتزی و شیک میو شاپ؛
    محصولات جدید را ببین و مدل مورد علاقه‌ات را پیدا کن.
</p>

</div>

<div class="hero-logo">

<img
    src="miushop-logo.jpg"
    alt="لوگوی میو شاپ"
>

</div>

</div>

</div>

</section>


<!-- ================= PRODUCTS ================= -->

<section id="products" class="container">

<div class="section-title">

<div>

<h2>
    ✨ محصولات میو شاپ
</h2>

<p id="countText"></p>

</div>

</div>


<div class="tools">

<input
    id="search"
    class="search"
    placeholder="🔎 جستجوی محصول..."
    oninput="renderProducts()"
>

<div id="filters" class="filters"></div>

</div>


<div
    id="productGrid"
    class="grid"
></div>

</section>


<!-- ================= ABOUT ================= -->

<section
    id="about"
    class="container"
    style="padding-bottom:50px"
>

<div class="box">

<h3>
    🎀 درباره MiuShop
</h3>

<p
    style="
        color:var(--muted);
        line-height:2;
        margin-bottom:0;
    "
>
    این سایت برای نمایش محصولات MiuShop ساخته شده
    و در حال حاضر امکان خرید آنلاین و سبد خرید ندارد.
</p>

</div>

</section>

</main>


<!-- ================= FOOTER ================= -->

<footer>

© 2026 MiuShop | میو شاپ — ساخته شده با 🎀

</footer>


<!-- ================= ADMIN MODAL ================= -->

<div
    id="modal"
    class="modal"
    onclick="if(event.target===this)closeAdmin()"
>

<div id="modalContent"></div>

</div>


<script>

/* =====================================================
   تنظیمات
===================================================== */


/* 🔐 رمز پنل مدیریت */

const ADMIN_PASSWORD = "1234";


/* =====================================================
   محصولات اولیه
===================================================== */

const defaultProducts = [

{
    id:1,
    name:"گیره پاپیونی صورتی",
    category:"اکسسوری مو",
    price:180000,
    discount:10,
    stock:8,
    image:"",
    emoji:"🎀"
},

{
    id:2,
    name:"گردنبند قلبی",
    category:"گردنبند",
    price:290000,
    discount:0,
    stock:5,
    image:"",
    emoji:"💗"
},

{
    id:3,
    name:"دستبند فانتزی",
    category:"دستبند",
    price:220000,
    discount:15,
    stock:12,
    image:"",
    emoji:"✨"
},

{
    id:4,
    name:"گوشواره پاپیونی",
    category:"گوشواره",
    price:250000,
    discount:5,
    stock:3,
    image:"",
    emoji:"🌸"
},

{
    id:5,
    name:"انگشتر ظریف",
    category:"انگشتر",
    price:195000,
    discount:0,
    stock:7,
    image:"",
    emoji:"💍"
},

{
    id:6,
    name:"کلیپس گربه‌ای",
    category:"اکسسوری مو",
    price:165000,
    discount:20,
    stock:10,
    image:"",
    emoji:"🐱"
}

];


/* =====================================================
   دریافت محصولات ذخیره‌شده
===================================================== */

let products =
    JSON.parse(
        localStorage.getItem("miushop_products")
    ) || defaultProducts;


let activeCategory = "همه";


/* =====================================================
   ذخیره
===================================================== */

function save(){

    localStorage.setItem(
        "miushop_products",
        JSON.stringify(products)
    );

}


/* =====================================================
   قیمت
===================================================== */

function toman(number){

    return Number(number).toLocaleString("fa-IR")
    + " تومان";

}


function finalPrice(product){

    return Math.round(
        product.price *
        (1 - (product.discount || 0) / 100)
    );

}


/* =====================================================
   دسته‌بندی‌ها
===================================================== */

function categories(){

    return [
        "همه",
        ...new Set(
            products
            .map(p => p.category)
            .filter(Boolean)
        )
    ];

}


/* =====================================================
   فیلترها
===================================================== */

function renderFilters(){

    document.getElementById("filters").innerHTML =
        categories().map(category => `

        <button
            class="filter ${
                category === activeCategory
                ? "active"
                : ""
            }"
            onclick='
                activeCategory=${JSON.stringify(category)};
                renderFilters();
                renderProducts();
            '
        >
            ${escapeHtml(category)}
        </button>

    `).join("");

}


/* =====================================================
   نمایش محصولات
===================================================== */

function renderProducts(){

    const search =
        document
        .getElementById("search")
        .value
        .trim()
        .toLowerCase();


    const list =
        products.filter(product =>

            (
                activeCategory === "همه"
                ||
                product.category === activeCategory
            )

            &&

            (
                !search
                ||
                product.name
                    .toLowerCase()
                    .includes(search)

                ||

                product.category
                    .toLowerCase()
                    .includes(search)
            )

        );


    document.getElementById("countText").textContent =
        `${list.length.toLocaleString("fa-IR")} محصول`;


    document.getElementById("productGrid").innerHTML =

        list.length

        ?

        list.map(product => {

            const price =
                finalPrice(product);


            const image =
                product.image

                ?

                `
                <img
                    src="${escapeAttr(product.image)}"
                    alt="${escapeAttr(product.name)}"
                >
                `

                :

                `
                <div class="placeholder">
                    ${product.emoji || "🎀"}
                </div>
                `;


            return `

            <article class="card">

                <div class="product-img">

                    ${
                        product.discount
                        ?

                        `
                        <span class="discount">
                            ${product.discount}% تخفیف
                        </span>
                        `

                        :

                        ""
                    }

                    ${image}

                </div>


                <div class="info">

                    <div class="category">
                        ${escapeHtml(product.category || "اکسسوری")}
                    </div>

                    <h3>
                        ${escapeHtml(product.name)}
                    </h3>


                    <div class="price">

                        <span class="final">
                            ${toman(price)}
                        </span>

                        ${
                            product.discount

                            ?

                            `
                            <span class="old">
                                ${toman(product.price)}
                            </span>
                            `

                            :

                            ""
                        }

                    </div>


                    <div
                        class="stock ${
                            product.stock <= 0
                            ? "out"
                            : ""
                        }"
                    >

                        ${
                            product.stock > 0

                            ?

                            `موجودی:
                            ${product.stock.toLocaleString("fa-IR")}
                            عدد`

                            :

                            "ناموجود"
                        }

                    </div>

                </div>

            </article>

            `;

        }).join("")

        :

        `
        <div class="empty">
            محصولی با این مشخصات پیدا نشد 🎀
        </div>
        `;

}


/* =====================================================
   امنیت نمایش متن
===================================================== */

function escapeHtml(value){

    return String(value ?? "")
        .replace(
            /[&<>"']/g,
            character => ({

                "&":"&amp;",
                "<":"&lt;",
                ">":"&gt;",
                '"':"&quot;",
                "'":"&#039;"

            }[character])
        );

}


function escapeAttr(value){

    return escapeHtml(value)
        .replace(/`/g,"&#096;");

}


/* =====================================================
   باز کردن پنل
===================================================== */

function openAdmin(){

    document
        .getElementById("modal")
        .classList.add("show");


    document.getElementById("modalContent").innerHTML = `

    <div class="panel login">

        <div
            style="
                display:flex;
                justify-content:space-between;
                align-items:center;
            "
        >

            <h2>
                🔐 ورود مدیریت
            </h2>

            <button
                class="close"
                onclick="closeAdmin()"
            >
                ×
            </button>

        </div>


        <p class="small">
            برای مدیریت محصولات رمز عبور را وارد کن.
        </p>


        <div class="field">

            <label>
                رمز عبور
            </label>

            <input
                id="adminPass"
                type="password"
                placeholder="رمز مدیریت"
            >

        </div>


        <button
            class="btn primary"
            style="width:100%"
            onclick="loginAdmin()"
        >
            ورود به پنل
        </button>


        <div
            id="loginError"
            class="small"
            style="
                color:#c65b71;
                margin-top:10px;
            "
        ></div>

    </div>

    `;

}


/* =====================================================
   ورود
===================================================== */

function loginAdmin(){

    const password =
        document.getElementById("adminPass").value;


    if(password === ADMIN_PASSWORD){

        renderAdmin();

    }

    else{

        document.getElementById(
            "loginError"
        ).textContent =
            "رمز عبور اشتباه است.";

    }

}


/* =====================================================
   پنل مدیریت
===================================================== */

function renderAdmin(){

    document.getElementById("modalContent").innerHTML = `

    <div class="panel">

        <div class="panel-head">

            <div>

                <b>
                    ⚙️ پنل مدیریت MiuShop
                </b>

                <div class="small">
                    افزودن، حذف، قیمت، تخفیف و موجودی
                </div>

            </div>


            <button
                class="close"
                onclick="closeAdmin()"
            >
                ×
            </button>

        </div>


        <div class="admin-body">

            <div class="notice">

                اطلاعات این پنل در
                <b>مرورگر همین دستگاه</b>
                ذخیره می‌شود.

                برای سایت استاتیک GitHub Pages،
                این رمز امنیت سروری واقعی ایجاد نمی‌کند.

            </div>


            <div class="admin-grid">


                <!-- افزودن محصول -->

                <div class="box">

                    <h3>
                        ➕ افزودن محصول
                    </h3>


                    <div class="field">

                        <label>
                            نام محصول
                        </label>

                        <input
                            id="pName"
                            placeholder="مثلاً گردنبند قلبی"
                        >

                    </div>


                    <div class="field">

                        <label>
                            دسته‌بندی
                        </label>

                        <input
                            id="pCat"
                            placeholder="مثلاً گردنبند"
                        >

                    </div>


                    <div class="row">

                        <div class="field">

                            <label>
                                قیمت (تومان)
                            </label>

                            <input
                                id="pPrice"
                                type="number"
                                min="0"
                            >

                        </div>


                        <div class="field">

                            <label>
                                تخفیف (%)
                            </label>

                            <input
                                id="pDiscount"
                                type="number"
                                min="0"
                                max="100"
                                value="0"
                            >

                        </div>

                    </div>


                    <div class="row">

                        <div class="field">

                            <label>
                                موجودی
                            </label>

                            <input
                                id="pStock"
                                type="number"
                                min="0"
                                value="1"
                            >

                        </div>


                        <div class="field">

                            <label>
                                ایموجی جایگزین عکس
                            </label>

                            <input
                                id="pEmoji"
                                value="🎀"
                                maxlength="3"
                            >

                        </div>

                    </div>


                    <div class="field">

                        <label>
                            آدرس عکس محصول
                        </label>

                        <input
                            id="pImage"
                            placeholder="مثلاً images/item1.jpg"
                        >

                    </div>


                    <button
                        class="btn primary"
                        style="width:100%"
                        onclick="addProduct()"
                    >
                        افزودن محصول
                    </button>

                </div>


                <!-- لیست محصولات -->

                <div class="box">

                    <h3>
                        📦 محصولات موجود
                    </h3>


                    <div class="products-admin">

                        ${
                            products.map(product => `

                            <div class="admin-item">


                                ${
                                    product.image

                                    ?

                                    `
                                    <img
                                        class="admin-thumb"
                                        src="${escapeAttr(product.image)}"
                                    >
                                    `

                                    :

                                    `
                                    <div
                                        class="admin-thumb"
                                        style="
                                            display:grid;
                                            place-items:center;
                                            font-size:28px;
                                        "
                                    >
                                        ${product.emoji || "🎀"}
                                    </div>
                                    `
                                }


                                <div class="grow">

                                    <b>
                                        ${escapeHtml(product.name)}
                                    </b>

                                    <div class="small">

                                        ${escapeHtml(product.category)}

                                        ·

                                        ${toman(finalPrice(product))}

                                        ·

                                        موجودی
                                        ${product.stock}

                                    </div>

                                </div>


                                <button
                                    class="btn secondary"
                                    onclick="editProduct(${product.id})"
                                >
                                    ویرایش
                                </button>


                                <button
                                    class="btn danger"
                                    onclick="deleteProduct(${product.id})"
                                >
                                    حذف
                                </button>


                            </div>

                            `).join("")

                            ||

                            `
                            <div class="small">
                                هنوز محصولی اضافه نشده.
                            </div>
                            `

                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

    `;

}


/* =====================================================
   افزودن محصول
===================================================== */

function addProduct(){

    const name =
        document
        .getElementById("pName")
        .value
        .trim();


    const category =
        document
        .getElementById("pCat")
        .value
        .trim();


    if(!name || !category){

        alert(
            "نام و دسته‌بندی را وارد کن."
        );

        return;

    }


    const product = {

        id:Date.now(),

        name:name,

        category:category,

        price:
            Math.max(
                0,
                +document.getElementById("pPrice").value || 0
            ),

        discount:
            Math.min(
                100,
                Math.max(
                    0,
                    +document.getElementById("pDiscount").value || 0
                )
            ),

        stock:
            Math.max(
                0,
                +document.getElementById("pStock").value || 0
            ),

        image:
            document
            .getElementById("pImage")
            .value
            .trim(),

        emoji:
            document
            .getElementById("pEmoji")
            .value
            ||
            "🎀"

    };


    products.unshift(product);


    save();

    activeCategory = "همه";

    renderFilters();

    renderProducts();

    renderAdmin();

}


/* =====================================================
   حذف محصول
===================================================== */

function deleteProduct(id){

    if(
        !confirm(
            "این محصول حذف شود؟"
        )
    ){

        return;

    }


    products =
        products.filter(
            product => product.id !== id
        );


    save();

    renderFilters();

    renderProducts();

    renderAdmin();

}


/* =====================================================
   ویرایش محصول
===================================================== */

function editProduct(id){

    const product =
        products.find(
            p => p.id === id
        );


    if(!product){
        return;
    }


    document.getElementById("modalContent").innerHTML = `

    <div class="panel login">


        <div
            style="
                display:flex;
                justify-content:space-between;
                align-items:center;
            "
        >

            <h2>
                ✏️ ویرایش محصول
            </h2>


            <button
                class="close"
                onclick="renderAdmin()"
            >
                ×
            </button>

        </div>


        <div class="field">

            <label>
                نام محصول
            </label>

            <input
                id="eName"
                value="${escapeAttr(product.name)}"
            >

        </div>


        <div class="field">

            <label>
                دسته‌بندی
            </label>

            <input
                id="eCat"
                value="${escapeAttr(product.category)}"
            >

        </div>


        <div class="row">

            <div class="field">

                <label>
                    قیمت (تومان)
                </label>

                <input
                    id="ePrice"
                    type="number"
                    value="${product.price}"
                >

            </div>


            <div class="field">

                <label>
                    تخفیف (%)
                </label>

                <input
                    id="eDiscount"
                    type="number"
                    min="0"
                    max="100"
                    value="${product.discount || 0}"
                >

            </div>

        </div>


        <div class="row">

            <div class="field">

                <label>
                    موجودی
                </label>

                <input
                    id="eStock"
                    type="number"
                    min="0"
                    value="${product.stock}"
                >

            </div>


            <div class="field">

                <label>
                    ایموجی
                </label>

                <input
                    id="eEmoji"
                    value="${escapeAttr(product.emoji || "🎀")}"
                >

            </div>

        </div>


        <div class="field">

            <label>
                آدرس عکس
            </label>

            <input
                id="eImage"
                value="${escapeAttr(product.image || "")}"
            >

        </div>


        <button
            class="btn primary"
            style="width:100%"
            onclick="saveEdit(${product.id})"
        >
            ذخیره تغییرات
        </button>


    </div>

    `;

}


/* =====================================================
   ذخیره ویرایش
===================================================== */

function saveEdit(id){

    const product =
        products.find(
            p => p.id === id
        );


    if(!product){
        return;
    }


    product.name =
        document.getElementById("eName")
        .value
        .trim()
        ||
        product.name;


    product.category =
        document.getElementById("eCat")
        .value
        .trim()
        ||
        product.category;


    product.price =
        Math.max(
            0,
            +document.getElementById("ePrice").value || 0
        );


    product.discount =
        Math.min(
            100,
            Math.max(
                0,
                +document.getElementById("eDiscount").value || 0
            )
        );


    product.stock =
        Math.max(
            0,
            +document.getElementById("eStock").value || 0
        );


    product.emoji =
        document.getElementById("eEmoji").value
        ||
        "🎀";


    product.image =
        document.getElementById("eImage")
        .value
        .trim();


    save();

    renderFilters();

    renderProducts();

    renderAdmin();

}


/* =====================================================
   بستن پنل
===================================================== */

function closeAdmin(){

    document
        .getElementById("modal")
        .classList.remove("show");

}


/* =====================================================
   شروع سایت
===================================================== */

renderFilters();

renderProducts();

</script>

</body>
</html>
